# Visual Studio / .NET Core .gitignore

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
**/bin/
**/obj/

# Rider
.idea/
*.sln.iml

# NuGet
packages/
*.nupkg
.nuget/

# Dotnet Core
project.lock.json
project.fragment.lock.json
artifacts/

# MSBuild
*.log
*.tlog
*.lastbuildstate

# Entity Framework
*.db

# StyleCop
StyleCopReport.xml

# ASP.NET
wwwroot/node_modules/
node_modules/

# User-specific files
*.rsuser
*.DotSettings.user

# OS generated files
.DS_Store
Thumbs.db

# JetBrains Rider and ReSharper
_ReSharper*/
*.DotSettings

# Debug folders
TestResults/

# Coverage
coverage*
*.coverage
*.coveragexml

# npm
package-lock.json

# Yarn
yarn.lock

# Logs
*.log

# Others
.env

# Ignore publish output
publish/

# Ignore local user secrets
secrets.json
